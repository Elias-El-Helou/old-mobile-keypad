<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Mark as test project -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Reference the library we're testing -->
  <ItemGroup>
    <ProjectReference Include="../OldMobileKeypad.Library/OldMobileKeypad.Library.csproj" />
  </ItemGroup>

  <!-- Testing framework: xUnit (industry standard) -->
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.2" />
  </ItemGroup>

</Project>